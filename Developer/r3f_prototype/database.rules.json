{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (auth.token.email === 'zard5388@gmail.com' && auth.token.email_verified === true && auth.token.firebase.sign_in_provider === 'google.com'))",
        ".write": "auth != null && (auth.uid === $uid || (auth.token.email === 'zard5388@gmail.com' && auth.token.email_verified === true && auth.token.firebase.sign_in_provider === 'google.com'))",
        ".validate": "newData.hasChildren(['schemaVersion', 'updatedAt', 'profile', 'progress'])",
        "schemaVersion": { ".validate": "newData.isNumber() && newData.val() === 1" },
        "updatedAt": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "profile": {
          ".validate": "newData.hasChildren(['uid', 'displayName', 'nickname'])",
          "uid": { ".validate": "newData.isString() && newData.val() === $uid" },
          "displayName": { ".validate": "newData.isString() && newData.val().length <= 100" },
          "nickname": { ".validate": "newData.isString() && newData.val().length <= 12" },
          "$other": { ".validate": false }
        },
        "progress": {
          ".validate": "newData.hasChildren(['goldTotal', 'records', 'titleSettings'])",
          "goldTotal": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000" },
          "records": {
            "$recordKey": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000" }
          },
          "weaponUnlocks": {
            "$weaponId": { ".validate": "newData.val() === 1" }
          },
          "weaponPermanentUpgrades": {
            "$weaponId": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10 && newData.val() % 1 === 0" }
          },
          "passiveUpgrades": {
            "$passiveId": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100 && newData.val() % 1 === 0" }
          },
          "bossPassiveUnlocks": {
            "b01SetSquare": { ".validate": "newData.isBoolean() && newData.val() === true" },
            "$other": { ".validate": false }
          },
          "encounteredZombieTypes": {
            "$zombieType": { ".validate": "newData.val() === 1 && ($zombieType === 'E01' || $zombieType === 'E02' || $zombieType === 'E03' || $zombieType === 'E04' || $zombieType === 'E05' || $zombieType === 'E06' || $zombieType === 'E07' || $zombieType === 'RZL' || $zombieType === 'RZC' || $zombieType === 'RZT' || $zombieType === 'RZG' || $zombieType === 'B01' || $zombieType === 'B02' || $zombieType === 'B03' || $zombieType === 'B04')" }
          },
          "missions": {
            ".validate": "newData.hasChildren(['schemaVersion', 'catalogVersion', 'updatedAt'])",
            "schemaVersion": { ".validate": "newData.isNumber() && newData.val() === 1" },
            "catalogVersion": { ".validate": "newData.isString() && newData.val().matches(/^missions_[0-9]{4}_[0-9]{2}_[0-9]{2}_v[0-9]+$/)" },
            "updatedAt": { ".validate": "newData.val() === '' || (newData.isString() && newData.val().length <= 40)" },
            "counters": {
              "$counterKey": { ".validate": "$counterKey.matches(/^[A-Za-z0-9_.-]{1,96}$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000 && newData.val() % 1 === 0" }
            },
            "active": {
              "$missionId": {
                ".validate": "$missionId.matches(/^[a-z0-9_]{1,64}$/) && newData.hasChildren(['counter', 'target'])",
                "counter": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000 && newData.val() % 1 === 0" },
                "target": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000000 && newData.val() % 1 === 0" },
                "completedAt": { ".validate": "newData.val() == null || (newData.isString() && newData.val().length <= 40)" },
                "claimedAt": { ".validate": "newData.val() == null || (newData.isString() && newData.val().length <= 40)" },
                "claimId": { ".validate": "newData.val() == null || (newData.isString() && newData.val().matches(/^[a-z0-9_:-]{1,140}$/))" },
                "$other": { ".validate": false }
              }
            },
            "completed": {
              "$missionId": {
                ".validate": "$missionId.matches(/^[a-z0-9_]{1,64}$/) && newData.hasChildren(['completedAt', 'counter', 'target'])",
                "completedAt": { ".validate": "newData.isString() && newData.val().length <= 40" },
                "counter": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000 && newData.val() % 1 === 0" },
                "target": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000000 && newData.val() % 1 === 0" },
                "$other": { ".validate": false }
              }
            },
            "claimed": {
              "$missionId": {
                ".validate": "$missionId.matches(/^[a-z0-9_]{1,64}$/) && newData.hasChildren(['claimedAt', 'claimId', 'catalogVersion', 'reward'])",
                "claimedAt": { ".validate": "newData.isString() && newData.val().length <= 40" },
                "claimId": { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9_:-]{1,140}$/)" },
                "catalogVersion": { ".validate": "newData.isString() && newData.val().matches(/^missions_[0-9]{4}_[0-9]{2}_[0-9]{2}_v[0-9]+$/)" },
                "reward": {
                  ".validate": "newData.hasChildren(['type', 'amount'])",
                  "type": { ".validate": "newData.isString() && newData.val() === 'gold'" },
                  "amount": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000000 && newData.val() % 1 === 0" },
                  "$other": { ".validate": false }
                },
                "$other": { ".validate": false }
              }
            },
            "pinnedMissionIds": {
              "$index": { ".validate": "$index.matches(/^[0-1]$/) && newData.isString() && newData.val().matches(/^[a-z0-9_]{1,64}$/)" }
            },
            "claimLedger": {
              "$claimId": {
                ".validate": "$claimId.matches(/^[a-z0-9_:-]{1,140}$/) && newData.hasChildren(['missionId', 'catalogVersion', 'claimedAt', 'reward'])",
                "missionId": { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9_]{1,64}$/)" },
                "catalogVersion": { ".validate": "newData.isString() && newData.val().matches(/^missions_[0-9]{4}_[0-9]{2}_[0-9]{2}_v[0-9]+$/)" },
                "claimedAt": { ".validate": "newData.isString() && newData.val().length <= 40" },
                "reward": {
                  ".validate": "newData.hasChildren(['type', 'amount'])",
                  "type": { ".validate": "newData.isString() && newData.val() === 'gold'" },
                  "amount": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000000 && newData.val() % 1 === 0" },
                  "$other": { ".validate": false }
                },
                "$other": { ".validate": false }
              }
            },
            "$other": { ".validate": false }
          },
          "titleSettings": {
            ".validate": "newData.hasChildren(['vibration', 'reducedEffects', 'unlockAllWeaponsCheat', 'unlockAllStagesCheat'])",
            "language": { ".validate": "newData.val() == null || (newData.isString() && (newData.val() === 'ko' || newData.val() === 'en' || newData.val() === 'ja'))" },
            "vibration": { ".validate": "newData.isBoolean()" },
            "reducedEffects": { ".validate": "newData.isBoolean()" },
            "hitCameraShake": { ".validate": "newData.isBoolean()" },
            "unlockAllWeaponsCheat": { ".validate": "newData.isBoolean()" },
            "unlockAllStagesCheat": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          },
          "$other": { ".validate": false }
        },
        "activity": {
          "lastStartedAt": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "lastStageId": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
          "$other": { ".validate": false }
        },
        "consent": {
          ".validate": "newData.hasChildren(['terms', 'privacy'])",
          "terms": {
            ".validate": "newData.hasChildren(['version', 'acceptedAt'])",
            "version": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100 && newData.val() % 1 === 0" },
            "acceptedAt": { ".validate": "newData.isString() && newData.val().length >= 10 && newData.val().length <= 40" },
            "$other": { ".validate": false }
          },
          "privacy": {
            ".validate": "newData.hasChildren(['version', 'acceptedAt'])",
            "version": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100 && newData.val() % 1 === 0" },
            "acceptedAt": { ".validate": "newData.isString() && newData.val().length >= 10 && newData.val().length <= 40" },
            "$other": { ".validate": false }
          },
          "$other": { ".validate": false }
        },
        "$other": { ".validate": false }
      }
    },
    "studioWorkspaces": {
      "v1": {
        "canonical": {
          "current": {
            ".read": true,
            ".write": "auth != null && auth.token.email === 'zard5388@gmail.com' && auth.token.email_verified === true && auth.token.firebase.sign_in_provider === 'google.com'",
            ".validate": "newData.hasChildren(['schemaVersion', 'revision', 'updatedAt', 'datasets'])",
            "schemaVersion": { ".validate": "newData.isNumber() && newData.val() === 1" },
            "revision": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 === 0" },
            "updatedAt": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "datasets": {
              "tunings": { ".validate": "newData.isString() && newData.val().length <= 1000000" },
              "sfxTunings": { ".validate": "newData.isString() && newData.val().length <= 1000000" },
              "stageBossPreview": { ".validate": "newData.isString() && newData.val().length <= 1000000" },
              "decals": { ".validate": "newData.isString() && newData.val().length <= 1000000" },
              "propPlacements": { ".validate": "newData.isString() && newData.val().length <= 1000000" },
              "bossFaceRecipes": { ".validate": "newData.isString() && newData.val().length <= 1000000" },
              "$other": { ".validate": false }
            },
            "$other": { ".validate": false }
          }
        }
      }
    },
    "runtimeControl": {
      "v1": {
        "inspection": {
          ".read": true,
          ".write": "auth != null && auth.token.email === 'zard5388@gmail.com' && auth.token.email_verified === true && auth.token.firebase.sign_in_provider === 'google.com'",
          ".validate": "newData.hasChildren(['schemaVersion', 'enabled', 'startsAt', 'endsAt', 'message', 'updatedAt', 'updatedByUid'])",
          "schemaVersion": { ".validate": "newData.isNumber() && newData.val() === 1" },
          "enabled": { ".validate": "newData.isBoolean()" },
          "startsAt": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= now - 300000 && newData.val() <= now + 604800000" },
          "endsAt": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() > newData.parent().child('startsAt').val() && newData.val() - newData.parent().child('startsAt').val() <= 604800000 && newData.val() <= now + 604800000" },
          "message": { ".validate": "newData.isString() && newData.val().length <= 200" },
          "updatedAt": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= now - 300000 && newData.val() <= now + 300000" },
          "updatedByUid": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128 && newData.val() === auth.uid" },
          "$other": { ".validate": false }
        },
        "$other": { ".validate": false }
      },
      "$other": { ".validate": false }
    },
    "rankingService": {
      "v1": {
        "public": {
          "$seasonId": {
            "global": {
              "$window": {
                "$periodKey": {
                  "entries": {
                    ".read": "$window === 'daily' || $window === 'weekly'",
                    ".indexOn": ["score"],
                    "$uid": {
                      ".write": "auth != null && $uid === auth.uid && ($window === 'daily' || $window === 'weekly') && (!newData.exists() || !data.exists() || newData.child('score').val() >= data.child('score').val())",
                      ".validate": "newData.hasChildren(['uid', 'displayName', 'score', 'timeMs', 'cleared', 'stageId', 'submittedAt']) && newData.child('timeMs').val() <= 300000 && newData.child('score').val() >= (newData.child('timeMs').val() / 1000) - 1 && newData.child('score').val() <= (newData.child('timeMs').val() / 1000 + (newData.child('stageId').val() === 'stage1' ? 0 : newData.child('stageId').val() === 'stage2' ? 60 : newData.child('stageId').val() === 'stage3' ? 120 : 180) + (newData.child('cleared').val() === true ? 30 : 0)) * (newData.child('cleared').val() === true ? 1.2 : 1)",
                      "uid": { ".validate": "newData.isString() && newData.val() === $uid" },
                      "displayName": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
                      "score": { ".validate": "newData.isNumber() && newData.val() >= 0" },
                      "timeMs": { ".validate": "newData.isNumber() && newData.val() >= 0" },
                      "cleared": { ".validate": "newData.isBoolean()" },
                      "stageId": { ".validate": "newData.isString() && (newData.val() === 'stage1' || newData.val() === 'stage2' || newData.val() === 'stage3' || newData.val() === 'stage4')" },
                      "submittedAt": { ".validate": "newData.isNumber() && newData.val() >= 0" },
                      "$other": { ".validate": false }
                    }
                  }
                }
              }
            },
            "stage": {
              "$stageId": {
                "$window": {
                  "$periodKey": {
                    "entries": {
                      ".read": "($window === 'daily' || $window === 'weekly') && ($stageId === 'stage1' || $stageId === 'stage2' || $stageId === 'stage3' || $stageId === 'stage4')",
                      ".indexOn": ["score"],
                      "$uid": {
                        ".write": "auth != null && $uid === auth.uid && ($window === 'daily' || $window === 'weekly') && ($stageId === 'stage1' || $stageId === 'stage2' || $stageId === 'stage3' || $stageId === 'stage4') && newData.child('stageId').val() === $stageId && (!newData.exists() || !data.exists() || newData.child('score').val() >= data.child('score').val())",
                        ".validate": "newData.hasChildren(['uid', 'displayName', 'score', 'timeMs', 'cleared', 'stageId', 'submittedAt']) && newData.child('timeMs').val() <= 300000 && newData.child('score').val() >= (newData.child('timeMs').val() / 1000) - 1 && newData.child('score').val() <= (newData.child('timeMs').val() / 1000 + (newData.child('stageId').val() === 'stage1' ? 0 : newData.child('stageId').val() === 'stage2' ? 60 : newData.child('stageId').val() === 'stage3' ? 120 : 180) + (newData.child('cleared').val() === true ? 30 : 0)) * (newData.child('cleared').val() === true ? 1.2 : 1)",
                        "uid": { ".validate": "newData.isString() && newData.val() === $uid" },
                        "displayName": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
                        "score": { ".validate": "newData.isNumber() && newData.val() >= 0" },
                        "timeMs": { ".validate": "newData.isNumber() && newData.val() >= 0" },
                        "cleared": { ".validate": "newData.isBoolean()" },
                        "stageId": { ".validate": "newData.isString() && (newData.val() === 'stage1' || newData.val() === 'stage2' || newData.val() === 'stage3' || newData.val() === 'stage4')" },
                        "submittedAt": { ".validate": "newData.isNumber() && newData.val() >= 0" },
                        "$other": { ".validate": false }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
