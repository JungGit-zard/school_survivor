{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "public": "dist",
    "cleanUrls": true,
    "ignore": [],
    "predeploy": [
      "node scripts/require-safe-hosting-promotion.mjs",
      "npm.cmd run build",
      "npm.cmd run build:legal"
    ],
    "headers": [
      {
        "source": "/game",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "/game/**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ],
    "rewrites": [
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "functions": {
    "source": "functions"
  }
}
