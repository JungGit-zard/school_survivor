{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "task_repo_root=\"$(git rev-parse --show-toplevel)\" && CODEX_PROJECT_DIR=\"$task_repo_root\" powershell -NoProfile -ExecutionPolicy Bypass -File \"$task_repo_root/.codex/hooks/require-today-resume-summary.ps1\"",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& (Join-Path (git rev-parse --show-toplevel) 'Developer/agent_room/hooks/run-project-hook.ps1') -Hook resume\""
          },
          {
            "type": "command",
            "command": "task_repo_root=\"$(git rev-parse --show-toplevel)\" && CODEX_PROJECT_DIR=\"$task_repo_root\" powershell -NoProfile -ExecutionPolicy Bypass -File \"$task_repo_root/Developer/agent_room/hooks/require-advisor-worker-mode.ps1\"",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& (Join-Path (git rev-parse --show-toplevel) 'Developer/agent_room/hooks/run-project-hook.ps1') -Hook advisor\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|shell_command|terminal|exec_command",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$(git rev-parse --show-toplevel)/Developer/agent_room/guards/destructive_shell_deletion_guard.py\"",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& (Join-Path (git rev-parse --show-toplevel) 'Developer/agent_room/hooks/run-project-hook.ps1') -Hook deletion\""
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/require-stage2-boss-v2-gate.sh\"",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& (Join-Path (git rev-parse --show-toplevel) 'Developer/agent_room/hooks/run-project-hook.ps1') -Hook stage2\""
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/require-stage2-boss-v2-gate.sh\"",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& (Join-Path (git rev-parse --show-toplevel) 'Developer/agent_room/hooks/run-project-hook.ps1') -Hook stage2\""
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/require-stage2-boss-v2-gate.sh\"",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& (Join-Path (git rev-parse --show-toplevel) 'Developer/agent_room/hooks/run-project-hook.ps1') -Hook stage2\""
          }
        ]
      },
      {
        "matcher": "MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/require-stage2-boss-v2-gate.sh\"",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& (Join-Path (git rev-parse --show-toplevel) 'Developer/agent_room/hooks/run-project-hook.ps1') -Hook stage2\""
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/check-gstack.sh\"",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& (Join-Path (git rev-parse --show-toplevel) 'Developer/agent_room/hooks/run-project-hook.ps1') -Hook gstack\""
          }
        ]
      }
    ]
  }
}
